+// User-selected compatibility binding, scoped to the OS-reported pad family.
+// Auto uses only native Options or explicit Select/View/Back/Minus aliases.
+void dm_gamepad_select_settings(UIViewController *presenter) {
+    GCController *c = nil;
+    for (GCController *candidate in GCController.controllers) if (candidate.extendedGamepad) { c = candidate; break; }
+    UIAlertController *sheet = [UIAlertController alertControllerWithTitle:@"Select / \u51cf\u53f7\u952e"
+        message:c ? [NSString stringWithFormat:@"%@\n\u9ed8\u8ba4\u4f7f\u7528\u7cfb\u7edf Select\uff1b\u4e0d\u54cd\u5e94\u65f6\u518d\u9009\u62e9 DS4 \u89e6\u6478\u677f\u6216 Share\u3002", c.vendorName ?: c.productCategory] : @"\u8bf7\u5148\u8fde\u63a5\u624b\u67c4"
+        preferredStyle:UIAlertControllerStyleActionSheet];
+    if (c) {
+        NSString *key = [NSString stringWithFormat:@"%@|%@", c.vendorName ?: @"?", c.productCategory ?: @"?"];
+        NSArray *names = @[@"auto", GCInputButtonOptions, GCInputDualShockTouchpadButton, GCInputButtonShare, GCInputButtonHome];
+        NSArray *titles = @[@"\u7cfb\u7edf Select\uff08\u81ea\u52a8\uff09", @"Options / Select", @"DS4 \u89e6\u6478\u677f\u6309\u4e0b", @"Share / \u5206\u4eab\u952e", @"Home\uff08\u624b\u52a8\u6307\u5b9a\uff09"];
+        NSMutableSet *seen = [NSMutableSet set];
+        for (NSUInteger i = 0; i < names.count; i++) {
+            NSString *name = names[i]; BOOL automatic = i == 0;
+            GCControllerButtonInput *button = c.physicalInputProfile.buttons[name];
+            if (!automatic && (!button || button == c.extendedGamepad.buttonMenu || [seen containsObject:button])) continue;
+            if (button) [seen addObject:button];
+            [sheet addAction:[UIAlertAction actionWithTitle:titles[i] style:UIAlertActionStyleDefault handler:^(UIAlertAction *action) {
+                (void)action;
+                NSMutableDictionary *saved = [[NSUserDefaults.standardUserDefaults dictionaryForKey:@"DmSelectBindings1"] mutableCopy] ?: [NSMutableDictionary dictionary];
+                if (automatic) [saved removeObjectForKey:key]; else saved[key] = name;
+                [NSUserDefaults.standardUserDefaults setObject:saved forKey:@"DmSelectBindings1"];
+                [g_view reset]; [g_view padsChanged:nil];
+            }]];
+        }
+    }
+    [sheet addAction:[UIAlertAction actionWithTitle:@"\u53d6\u6d88" style:UIAlertActionStyleCancel handler:nil]];
+    sheet.popoverPresentationController.sourceView = presenter.view;
+    sheet.popoverPresentationController.sourceRect = CGRectMake(CGRectGetMidX(presenter.view.bounds), CGRectGetMidY(presenter.view.bounds), 1, 1);
+    [presenter presentViewController:sheet animated:YES completion:nil];
+}
 
