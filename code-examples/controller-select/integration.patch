+// Dedicated callbacks cover Options/Menu separately from the profile callback.
+// Both publish the same state, so hle_hid.c latches each press once, including
+// when the profile also notifies. No touch reset or touch visibility gate here.
+static void pad_bind_menu(GCController *c) {
+    GCExtendedGamepad *g = c.extendedGamepad;
+    __weak GCExtendedGamepad *weak = g;
+    NSString *key = [NSString stringWithFormat:@"%@|%@", c.vendorName ?: @"?", c.productCategory ?: @"?"];
+    NSString *source = [NSUserDefaults.standardUserDefaults dictionaryForKey:@"DmSelectBindings1"][key];
+    dm_controller_bind_menu(g, source, ^{ GCExtendedGamepad *live = weak; if (live) read_pad(live); });
+    GCControllerButtonInput *select = dm_controller_select(g);
+    LOG("controller menu: vendor='%s' product='%s' select=%s options=%s gesture=%ld",
+        c.vendorName.UTF8String ?: "?", c.productCategory.UTF8String ?: "?",
+        select ? "available" : "missing", source.UTF8String ?: (g.buttonOptions ? "native" : "alias-or-absent"),
+        (long)select.preferredSystemGestureState);
 }
 // Home and Capture: without this iOS takes them as system gestures (Home opens the Games overlay, Capture a screenshot); the app gives them no function
